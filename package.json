{
  "name": "pos-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "ফার্মেসি ও কসমেটিক্স দোকানের মোবাইল-প্রথম POS (PWA)",
  "scripts": {
    "dev": "next dev",
    "dev:proxy": "node scripts/dev-proxy.mjs",
    "dev:local": "node scripts/dev-proxy.mjs --next",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
