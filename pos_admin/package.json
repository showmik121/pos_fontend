{
  "name": "pos-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Bipone platform admin panel (operators only; English UI)",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build && node scripts/csp-headers.mjs",
    "typecheck": "tsc --noEmit",
